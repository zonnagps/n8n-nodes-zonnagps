{
  "name": "n8n-nodes-zonnagps",
  "version": "1.0.5",
  "description": "n8n community node for ZonnaGPS fleet management: vehicles, drivers, places, transport documents (DeCA), data tables and a signed webhook trigger.",
  "keywords": [
    "n8n-community-node-package",
    "zonnagps",
    "gps",
    "fleet-management",
    "deca"
  ],
  "license": "MIT",
  "homepage": "https://app.zonnagps.es/api/docs",
  "author": {
    "name": "ZonnaGPS",
    "email": "soporte@zonnagps.com"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-icons.mjs",
    "test": "npm run build && node --test test/nodes.test.mjs"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ZonnaGpsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ZonnaGps/ZonnaGps.node.js",
      "dist/nodes/ZonnaGpsTrigger/ZonnaGpsTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "n8n-workflow": "2.16.0",
    "typescript": "~5.6.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zonnagps/n8n-nodes-zonnagps.git"
  },
  "bugs": {
    "url": "https://github.com/zonnagps/n8n-nodes-zonnagps/issues"
  }
}
